{
  "name": "be-gunasmash",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "npx prisma generate && rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_ENV=test TZ=Asia/Jakarta PORT=4000 DATABASE_URL=mongodb://127.0.0.1:27017/gunasmash-unit-test JWT_ACCESS_SECRET=unit-test-access-secret JWT_REFRESH_SECRET=unit-test-refresh-secret JWT_ACCESS_EXPIRES=15m JWT_REFRESH_EXPIRES=7d CLOUDINARY_CLOUD_NAME=unit-test-cloud CLOUDINARY_API_KEY=unit-test-api-key CLOUDINARY_API_SECRET=unit-test-api-secret CORS_WHITELIST=http://localhost:3000,http://127.0.0.1:3000,vercel.app tsx --test",
    "test:coverage": "npm run test:unit -- --experimental-test-coverage",
    "typecheck:test": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:gen": "prisma generate",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "busboy": "^1.6.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-csv": "^5.0.5",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "typescript-eslint": "^8.46.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^5.20.0",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
